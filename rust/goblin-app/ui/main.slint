import { Button, LineEdit, ScrollView, ListView, VerticalBox, HorizontalBox } from "std-widgets.slint";

export struct SessionRow { id: string, title: string }
export struct ModelRow { provider: string, id: string, label: string }
export struct ProfileRow { name: string, label: string }

export component MainWindow inherits Window {
    icon: @image-url("../resources/mipmap-hdpi/ic_launcher.png");
    title: "Mobile Goblin";
    background: #0c1212;
    preferred-width: 390px;
    preferred-height: 820px;

    in-out property <string> status: "Enter your Hermes dashboard address";
    in-out property <string> conversation: "";
    in-out property <string> composer-text: "";
    in-out property <string> session-id: "";
    in-out property <[SessionRow]> sessions: [];
    in-out property <[ModelRow]> models: [];
    in-out property <[ProfileRow]> profiles: [];
    in-out property <string> selected-profile: "default";
    in-out property <string> selected-model: "Profile default";
    in-out property <bool> show-models: false;
    in-out property <bool> show-profiles: false;
    in-out property <bool> show-sessions: false;
    in-out property <bool> show-menu: false;
    in-out property <bool> connected: false;
    in-out property <bool> busy: false;
    in-out property <bool> show-settings: false;
    in-out property <string> selected-effort: "Profile default";
    in-out property <bool> fast: false;
    in-out property <string> resource-view: "";
    in-out property <string> resource-content: "";
    in-out property <bool> input-pending: false;
    in-out property <bool> input-approval: false;
    in-out property <bool> input-masked: false;
    in-out property <bool> allow-session: false;
    in-out property <bool> allow-always: false;
    in-out property <string> input-title: "";
    in-out property <string> input-detail: "";
    callback connect(string, string, string);
    callback new-chat();
    callback refresh-sessions();
    callback open-session(string);
    callback send-message(string);
    callback answer-choice(string);
    callback answer-text(string);
    callback cancel-input();
    callback interrupt();
    callback refresh-models();
    callback select-model(string, string);
    callback refresh-profiles();
    callback select-profile(string);
    callback set-effort(string);
    callback set-fast(bool);
    callback steer(string);
    callback load-resource(string);
    callback manage-job(string, string, string, string);
    callback title-chat(string);
    callback archive-chat();
    callback branch-chat(string);
    callback skill-action(string, string);
    callback tool-action(string, string);
    callback mcp-test(string);

    VerticalBox {
        x: root.safe-area-insets.left + 14px;
        y: root.safe-area-insets.top + 14px;
        width: root.width - root.safe-area-insets.left - root.safe-area-insets.right - 28px;
        height: root.virtual-keyboard-size.height > 0px
            ? max(0px, root.virtual-keyboard-position.y - root.safe-area-insets.top - 14px)
            : root.height - root.safe-area-insets.top - root.safe-area-insets.bottom - 28px;
        spacing: 10px;

        HorizontalBox {
            height: 70px;
            spacing: 10px;
            Image {
                source: @image-url("../resources/mipmap-hdpi/ic_launcher.png");
                width: 60px;
                height: 60px;
                image-fit: contain;
            }
            VerticalBox {
                Text { text: "MOBILE GOBLIN"; color: #c6ff6c; font-size: 23px; font-weight: 800; }
                Text { text: "Hermes in your pocket"; color: #a5bbb0; font-size: 14px; }
            }
        }

        Text { text: root.status; color: root.connected ? #c6ff6c : #ffca8f; wrap: word-wrap; font-size: 13px; }

        if root.input-pending : VerticalBox {
            spacing: 7px;
            Rectangle { height: 2px; background: #c6ff6c; }
            Text { text: root.input-title; color: #c6ff6c; font-size: 18px; font-weight: 700; wrap: word-wrap; }
            Text { text: root.input-detail; color: #ebf9f0; font-size: 14px; wrap: word-wrap; }
            if root.input-approval : HorizontalBox {
                Button { text: "Allow once"; clicked => { root.answer-choice("once"); } }
                if root.allow-session : Button { text: "Session"; clicked => { root.answer-choice("session"); } }
                if root.allow-always : Button { text: "Always"; clicked => { root.answer-choice("always"); } }
                Button { text: "Deny"; clicked => { root.answer-choice("deny"); } }
            }
            if !root.input-approval : HorizontalBox {
                answer := LineEdit { input-type: root.input-masked ? InputType.password : InputType.text; placeholder-text: "Your answer"; }
                Button { text: "Submit"; clicked => { root.answer-text(answer.text); answer.text = ""; } }
                Button { text: "Skip"; clicked => { root.cancel-input(); answer.text = ""; } }
            }
            Rectangle { height: 2px; background: #c6ff6c; }
        }

        if !root.connected : login-scroll := ScrollView {
            vertical-stretch: 1;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            property <length> keyboard-height: root.virtual-keyboard-size.height;
            changed keyboard-height => {
                if (password.has-focus) {
                    login-scroll.content-y = max(min(0px, login-scroll.visible-height - login-form.height),
                        min(0px, login-scroll.visible-height - password.y - password.height - 20px));
                } else if (username.has-focus) {
                    login-scroll.content-y = max(min(0px, login-scroll.visible-height - login-form.height),
                        min(0px, login-scroll.visible-height - username.y - username.height - 20px));
                }
            }
            login-form := VerticalBox {
                width: parent.width - 8px;
                spacing: 8px;
                Text { text: "Dashboard address"; color: #d6e9df; }
                gateway := LineEdit {
                    placeholder-text: "http://your-tailnet-host:9119";
                    accepted => { username.focus(); }
                    changed has-focus => { if (self.has-focus) { login-scroll.content-y = 0px; } }
                }
                Text { text: "Username"; color: #d6e9df; }
                username := LineEdit {
                    placeholder-text: "Hermes username";
                    accepted => { password.focus(); }
                    changed has-focus => {
                        if (self.has-focus) {
                            login-scroll.content-y = max(min(0px, login-scroll.visible-height - login-form.height),
                                min(0px, login-scroll.visible-height - self.y - self.height - 20px));
                        }
                    }
                }
                Text { text: "Password"; color: #d6e9df; }
                password := LineEdit {
                    input-type: InputType.password;
                    placeholder-text: "Hermes password";
                    accepted => { root.connect(gateway.text, username.text, password.text); }
                    changed has-focus => {
                        if (self.has-focus) {
                            login-scroll.content-y = max(min(0px, login-scroll.visible-height - login-form.height),
                                min(0px, login-scroll.visible-height - self.y - self.height - 20px));
                        }
                    }
                }
                Button {
                    text: "Connect to Hermes";
                    clicked => { root.connect(gateway.text, username.text, password.text); }
                }
                Text { text: "Use HTTPS for public hosts. HTTP is allowed on private networks."; color: #90a99e; wrap: word-wrap; font-size: 12px; }
            }
        }

        if root.connected : VerticalBox {
            spacing: 9px;
            HorizontalBox {
                Text { text: root.session-id == "" ? "New chat" : "Chat ready"; color: #d6e9df; font-size: 17px; }
                Button { text: "Menu"; clicked => { root.show-menu = !root.show-menu; } }
                Button { text: "New"; clicked => { root.new-chat(); root.show-sessions = false; root.resource-view = ""; root.show-menu = false; } }
                Button { text: "Stop"; enabled: root.busy; clicked => { root.interrupt(); } }
            }
            if root.show-menu : ScrollView {
                height: 270px;
                menu-items := VerticalBox {
                    width: parent.width - 8px;
                    spacing: 5px;
                    Button { text: "Chats"; clicked => { root.resource-view = ""; root.show-sessions = true; root.refresh-sessions(); root.show-menu = false; } }
                    Button { text: "Scheduled jobs"; clicked => { root.resource-view = "jobs"; root.load-resource("jobs"); root.show-menu = false; } }
                    Button { text: "Skills"; clicked => { root.resource-view = "skills"; root.load-resource("skills"); root.show-menu = false; } }
                    Button { text: "Toolsets"; clicked => { root.resource-view = "tools"; root.load-resource("tools"); root.show-menu = false; } }
                    Button { text: "MCP servers"; clicked => { root.resource-view = "mcp"; root.load-resource("mcp"); root.show-menu = false; } }
                    Button { text: "Chat settings"; clicked => { root.resource-view = ""; root.show-settings = true; root.show-menu = false; } }
                }
            }
            if root.resource-view == "" : HorizontalBox {
                Text { text: "Agent: " + root.selected-profile; color: #a5bbb0; font-size: 12px; }
                Button { text: "Agents"; clicked => { root.show-profiles = !root.show-profiles; root.show-models = false; if (root.show-profiles) { root.refresh-profiles(); } } }
                Button { text: "Models"; clicked => { root.show-models = !root.show-models; root.show-profiles = false; if (root.show-models) { root.refresh-models(); } } }
            }
            if root.resource-view == "" : Text { text: "Model: " + root.selected-model; color: #a5bbb0; font-size: 12px; }
            if root.resource-view != "" : VerticalBox {
                vertical-stretch: 1;
                spacing: 5px;
                HorizontalBox {
                    Text { text: root.resource-view; color: #c6ff6c; font-size: 17px; }
                    Button { text: "Refresh"; clicked => { root.load-resource(root.resource-view); } }
                    Button { text: "Close"; clicked => { root.resource-view = ""; } }
                }
                if root.resource-view == "jobs" : VerticalBox {
                    job-name := LineEdit { placeholder-text: "Job name"; }
                    job-schedule := LineEdit { placeholder-text: "Schedule (e.g. 0 9 * * *)"; }
                    job-prompt := LineEdit { placeholder-text: "Prompt for Hermes"; }
                    HorizontalBox {
                        Button { text: "Add job"; clicked => { root.manage-job("add", job-name.text, job-schedule.text, job-prompt.text); } }
                        Button { text: "Pause"; clicked => { root.manage-job("pause", job-name.text, "", ""); } }
                        Button { text: "Resume"; clicked => { root.manage-job("resume", job-name.text, "", ""); } }
                        Button { text: "Remove"; clicked => { root.manage-job("remove", job-name.text, "", ""); } }
                    }
                }
                if root.resource-view == "skills" : VerticalBox {
                    skill-query := LineEdit { placeholder-text: "Search or skill identifier"; }
                    HorizontalBox {
                        Button { text: "Search"; clicked => { root.skill-action("search", skill-query.text); } }
                        Button { text: "Browse"; clicked => { root.skill-action("browse", ""); } }
                        Button { text: "Inspect"; clicked => { root.skill-action("inspect", skill-query.text); } }
                        Button { text: "Install"; clicked => { root.skill-action("install", skill-query.text); } }
                    }
                }
                if root.resource-view == "tools" : VerticalBox {
                    tool-name := LineEdit { placeholder-text: "Toolset name"; }
                    HorizontalBox {
                        Button { text: "Enable"; clicked => { root.tool-action("enable", tool-name.text); } }
                        Button { text: "Disable"; clicked => { root.tool-action("disable", tool-name.text); } }
                    }
                }
                if root.resource-view == "mcp" : VerticalBox {
                    server-name := LineEdit { placeholder-text: "MCP server name"; }
                    Button { text: "Test connection"; clicked => { root.mcp-test(server-name.text); } }
                }
                ScrollView {
                    vertical-stretch: 1;
                    Text { text: root.resource-content; color: #ebf9f0; wrap: word-wrap; font-size: 13px; width: parent.width - 22px; }
                }
            }
            if root.resource-view == "" : Button { text: root.show-settings ? "Hide controls" : "Reasoning & speed"; clicked => { root.show-settings = !root.show-settings; } }
            if root.resource-view == "" && root.show-settings : VerticalBox {
                Text { text: "Reasoning: " + root.selected-effort; color: #d6e9df; font-size: 12px; }
                HorizontalBox {
                    Button { text: "Off"; clicked => { root.set-effort("none"); } }
                    Button { text: "Low"; clicked => { root.set-effort("low"); } }
                    Button { text: "Medium"; clicked => { root.set-effort("medium"); } }
                    Button { text: "High"; clicked => { root.set-effort("high"); } }
                }
                Button { text: root.fast ? "Fast tier on" : "Fast tier off"; clicked => { root.fast = !root.fast; root.set-fast(root.fast); } }
            }
            if root.resource-view == "" && root.show-profiles : ListView {
                height: 150px;
                for profile in root.profiles: Button {
                    text: profile.label;
                    clicked => { root.select-profile(profile.name); root.show-profiles = false; }
                }
            }
            if root.resource-view == "" && root.show-models : ListView {
                height: 180px;
                for model in root.models: Button {
                    text: model.label;
                    clicked => { root.select-model(model.provider, model.id); root.show-models = false; }
                }
            }
            if root.resource-view == "" && root.show-sessions : ListView {
                height: 180px;
                for session in root.sessions: Button {
                    text: session.title;
                    clicked => { root.open-session(session.id); root.show-sessions = false; }
                }
            }
            if root.resource-view == "" && root.session-id != "" : VerticalBox {
                chat-title := LineEdit { placeholder-text: "Chat title or branch name"; }
                HorizontalBox {
                    Button { text: "Rename"; clicked => { root.title-chat(chat-title.text); } }
                    Button { text: "Branch"; clicked => { root.branch-chat(chat-title.text); } }
                    Button { text: "Archive"; clicked => { root.archive-chat(); } }
                }
            }
            if root.resource-view == "" : ScrollView {
                vertical-stretch: 1;
                Text {
                    text: root.conversation == "" ? "Ask Hermes anything." : root.conversation;
                    color: #ebf9f0;
                    wrap: word-wrap;
                    font-size: 16px;
                    width: parent.width - 22px;
                }
            }
            if root.resource-view == "" : LineEdit { text <=> root.composer-text; placeholder-text: "Message Hermes"; }
            if root.resource-view == "" : HorizontalBox {
            Button {
                text: "Send";
                enabled: root.composer-text != "";
                clicked => {
                    root.send-message(root.composer-text);
                    root.composer-text = "";
                }
            }
            Button {
                text: "Steer";
                enabled: root.busy && root.composer-text != "";
                clicked => { root.steer(root.composer-text); root.composer-text = ""; }
            }
            }
        }
    }
}
